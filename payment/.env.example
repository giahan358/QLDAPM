# Copy to .env. Never commit real credentials. Apache must honor .htaccess.
vnp_TmnCode=
vnp_HashSecret=
VNP_RETURN_URL=https://your-public-host/qlpm/payment/vnpay-return
VNP_IPN_URL=https://your-public-host/qlpm/user/user/controller/vnpay.php?action=ipn
# For the existing hoadon checkout adapter (set both to the same public host path if preferred).
VNP_LEGACY_RETURN_URL=https://your-public-host/qlpm/user/user/controller/vnpay.php?action=return
VNP_LEGACY_IPN_URL=https://your-public-host/qlpm/user/user/controller/vnpay.php?action=ipn
VNP_SERVER_IP=127.0.0.1
PAYMENT_DB_DSN=mysql:host=127.0.0.1;dbname=webbansach;charset=utf8mb4
PAYMENT_DB_USER=root
PAYMENT_DB_PASSWORD=
# Dedicated operator API key: at least 32 random bytes (hex-encoded).
# Do not embed this key in storefront JavaScript.
PAYMENT_ADMIN_KEY=
